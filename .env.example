# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_THROTTLER_MODE: "live" (default) uses the real image service for
# folder/file-type icons; "mock" keeps local lucide icons only.
VITE_THROTTLER_MODE=live

# VITE_IMAGE_SERVER_URL: image service (typescript/image-server) used for
# icon substitution in live mode. Defaults to http://localhost:9081 when unset.
VITE_IMAGE_SERVER_URL=http://localhost:9081

# VITE_THROTTLER_FILE_MODE: "live" (default) uses the real file-system-server
# for listing/read/create/update/delete/rename/move/copy; "mock" keeps
# INITIAL_FILES + localStorage only.
VITE_THROTTLER_FILE_MODE=live

# VITE_FILE_SRV_URL: file service (typescript/file-system-server) backing the
# live file browser. Defaults to http://localhost:4042 when unset.
VITE_FILE_SRV_URL=http://localhost:4042
